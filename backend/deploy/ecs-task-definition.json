{
  "family": "wallaza-service-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::123456789012:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::123456789012:role/wallazaServiceTaskRole",
  "containerDefinitions": [
    {
      "name": "wallaza-service",
      "image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/wallaza-service:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SERVER_PORT", "value": "8080" },
        { "name": "WALLAZA_BASE_URL", "value": "https://api.wallaza.com/v1" },
        { "name": "JAVA_OPTS", "value": "-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError" }
      ],
      "secrets": [
        {
          "name": "WALLAZA_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:wallaza/api_key"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8080/actuator/health || exit 1"],
        "interval": 15,
        "timeout": 3,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/wallaza-service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
