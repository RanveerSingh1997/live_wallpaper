# Wallora Cloud Kubernetes Secret Template
# Copy to secret.yaml (git-ignored) and replace with base64-encoded production credentials
apiVersion: v1
kind: Secret
metadata:
  name: wallaza-service-secret
  namespace: wallora
  labels:
    app.kubernetes.io/name: wallaza-service
    app.kubernetes.io/part-of: wallora-platform
type: Opaque
data:
  # Base64 encoded Wallaza API key: echo -n "your_api_key_here" | base64
  WALLAZA_API_KEY: ZGVtb19rZXk=
