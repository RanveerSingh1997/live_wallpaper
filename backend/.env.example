# ==============================================================================
# Wallaza Service Environment Configuration Template
# Copy this file to .env and adjust variables as required:
#   cp .env.example .env
# ==============================================================================

# Server Port
SERVER_PORT=8080

# Wallaza API Configuration
# Get your API key from Wallaza Developer Portal (https://wallaza.com/developers)
WALLAZA_API_KEY=58241521-8a91e1aa8dfce02c3a42eba21
WALLAZA_BASE_URL=https://pixabay.com/api

# JVM Memory and Garbage Collection Tuning (Optional)
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
