<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Wallora Security Policy: Enforce HTTPS for all remote cloud connections -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
